   "source": [
    "scores = [63, 34, 69, 57, 64]\n",
    "total = 0\n",
    "passed = 0\n",
    "for score in scores:\n",
    "    total = total + score\n",
    "    if score >= 50:\n",
    "        passed += 1\n",
    "print(\"Total:\", total)\n",
    "print(\"Average:\", total / len(scores))\n",
    "print(\"Passed:\", passed, \"of\", len(scores))"
   ],
